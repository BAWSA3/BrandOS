// ----------------------------------------------------------------------------
// New enums — add at the top of schema.prisma alongside existing enums
// ----------------------------------------------------------------------------

enum PlanTier {
  FREE
  PRO
  MAX
  TEAM
  ENTERPRISE
}

enum WorkspaceType {
  personal
  team
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum ConnectedAccountStatus {
  active
  dormant
}

enum ScanVisibility {
  private
  card_public
}

enum ScanStatus {
  active
  dormant
  archived
}

enum AuditEventCategory {
  auth
  scan
  payment
  security
  account
}

enum UserRole {
  user
  admin
}

enum AccountMigrationStatus {
  legacy
  in_progress
  completed
}

// ----------------------------------------------------------------------------
// User — additive columns. Merge these into the existing User model.
// Do NOT remove existing subscription fields yet — those drop in migration 007.
// ----------------------------------------------------------------------------

// Add to existing model User { ... }:
//   role                       UserRole               @default(user)
//   accountMigrationStatus     AccountMigrationStatus @default(legacy) @map("account_migration_status")
//   ownedWorkspaces            Workspace[]            @relation("WorkspaceOwner")
//   workspaceMemberships       WorkspaceMember[]
//   brandScans                 BrandScan[]
//   auditReportShares          AuditReportShare[]
//   securityAuditEvents        SecurityAuditLog[]

// ----------------------------------------------------------------------------
// New models
// ----------------------------------------------------------------------------

model Workspace {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  type                 WorkspaceType
  ownerUserId          String         @map("owner_user_id")
  owner                User           @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  plan                 PlanTier       @default(FREE)
  seatCount            Int            @default(1) @map("seat_count")
  stripeCustomerId     String?        @unique @map("stripe_customer_id")
  stripeSubscriptionId String?        @unique @map("stripe_subscription_id")
  trialEndsAt          DateTime?      @map("trial_ends_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  members              WorkspaceMember[]
  brandScans           BrandScan[]
  auditReportShares    AuditReportShare[]
  securityAuditEvents  SecurityAuditLog[]

  @@index([ownerUserId])
  @@map("Workspace")
}

model WorkspaceMember {
  workspaceId        String         @map("workspace_id") @db.Uuid
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId             String         @map("user_id")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               WorkspaceRole  @default(member)
  invitedByUserId    String?        @map("invited_by_user_id")
  joinedAt           DateTime       @default(now()) @map("joined_at") @db.Timestamptz

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("WorkspaceMember")
}

// PlatformConnection — extend the EXISTING model in schema.prisma with these fields:
//   workspaceId             String?                 @map("workspace_id") @db.Uuid
//   workspace               Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
//   status                  ConnectedAccountStatus  @default(active)
//   keyId                   String                  @default("v1") @map("key_id")
//   accessTokenCiphertext   String?                 @map("access_token_ciphertext")
//   refreshTokenCiphertext  String?                 @map("refresh_token_ciphertext")
//   disconnectedAt          DateTime?               @map("disconnected_at") @db.Timestamptz
//   lastVerifiedAt          DateTime                @default(now()) @map("last_verified_at") @db.Timestamptz
//   brandScans              BrandScan[]

model PlanLimit {
  plan                         PlanTier  @id
  scansPerDay                  Int       @map("scans_per_day")
  xAccountsPerSeat             Int       @map("x_accounts_per_seat")
  multiPlatformEnabled         Boolean   @default(false) @map("multi_platform_enabled")
  competitorWatchlistEnabled   Boolean   @default(false) @map("competitor_watchlist_enabled")
  scheduledRescansEnabled      Boolean   @default(false) @map("scheduled_rescans_enabled")
  priorityQueueEnabled         Boolean   @default(false) @map("priority_queue_enabled")
  maxFlaggedTweets             Int       @default(3) @map("max_flagged_tweets")
  auditSummaryMaxChars         Int       @default(800) @map("audit_summary_max_chars")
  maxStrengths                 Int       @default(3) @map("max_strengths")
  maxImprovements              Int       @default(3) @map("max_improvements")

  @@map("PlanLimit")
}

model BrandScan {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String              @map("user_id")
  user                   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspaceId            String              @map("workspace_id") @db.Uuid
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformConnectionId   String              @map("platform_connection_id")
  platformConnection     PlatformConnection  @relation(fields: [platformConnectionId], references: [id], onDelete: Restrict)
  xUsername              String              @map("x_username")

  score                  Int
  archetype              String
  phaseScores            Json                @map("phase_scores")
  strengths              Json
  improvements           Json
  insights               Json?
  summary                String?
  influenceTier          String?             @map("influence_tier")
  nextMoves              Json?               @map("next_moves")
  contentPillars         Json?               @map("content_pillars")

  visibility             ScanVisibility      @default(card_public)
  status                 ScanStatus          @default(active)
  scannedAt              DateTime            @default(now()) @map("scanned_at") @db.Timestamptz

  shares                 AuditReportShare[]

  @@index([userId])
  @@index([workspaceId])
  @@index([platformConnectionId])
  @@map("BrandScan")
}

model AuditReportShare {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandScanId       String?    @map("brand_scan_id") @db.Uuid
  brandScan         BrandScan? @relation(fields: [brandScanId], references: [id], onDelete: Cascade)
  workspaceId       String     @map("workspace_id") @db.Uuid
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId   String     @map("created_by_user_id")
  createdBy         User       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  token             String     @unique
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz
  viewCount         Int        @default(0) @map("view_count")
  uniqueViewerCount Int        @default(0) @map("unique_viewer_count")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([token])
  @@index([workspaceId])
  @@map("AuditReportShare")
}

model SecurityAuditLog {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category        AuditEventCategory
  eventType       String              @map("event_type")
  userId          String?             @map("user_id")
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId     String?             @map("workspace_id") @db.Uuid
  workspace       Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  success         Boolean             @default(true)
  metadata        Json                @default("{}")
  ipHash          String?             @map("ip_hash")
  userAgentFamily String?             @map("user_agent_family")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("SecurityAuditLog")
}

// ----------------------------------------------------------------------------
// Notes for the merger
// ----------------------------------------------------------------------------
//
// 1. After merging, run:
//      npx prisma generate
//
// 2. The existing User model's subscription fields (stripeCustomerId,
//    stripeSubscriptionId, subscriptionTier, subscriptionStatus, billingInterval,
//    currentPeriodEnd) stay for now. They get dropped in migration 007.
//
// 3. The existing Team and TeamMember models stay for now. They have unique
//    constraint names that won't conflict with WorkspaceMember. Drop in 007.
//
// 4. AuditReportShareView is intentionally not modeled — it's an internal
//    view-tracking table written only via service-role from the share route.
//    No app code reads from it via Prisma.
//
// 5. brand_scans_public_card is a view, not a table. Query it via raw SQL
//    or via the Supabase client when needed (typically only from the public
//    /card/[username] route).
// ============================================================================
