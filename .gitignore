# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# npm config with tokens

# vercel (project link folders — never commit; covers .vercel and .vercel.staging)
.vercel*

# IDE and tool configs
.claude/
.cursor/*
!.cursor/rules/
.playwright-mcp/

# Separate projects
/relique/

# Windows artifacts
nul

# Data files with PII (signup exports contain emails) + generated charts
data/*.json
data/*.csv
data/*.html

# typescript
*.tsbuildinfo
next-env.d.ts
prisma/dev.db

# AI Studio exports
brandkit-for-ai-studio.txt

# Local motion-plus source (not needed - inlined)
plus/
superpowers/
.env*.local
.vercel
